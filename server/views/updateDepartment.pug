extends layout
block pageTitle
  | Edit Department – SLU EMS Admin
block content
  a.back-link(href='/departments') ← Back to Departments

  .page-header
    h1 Edit: #{department.depName}

  .card
    .card-header
      h2 Department Details
    .card-body
      form.form-wrap(action=`/updateDepartment/${department.depID}`, method='POST')
        .form-group
          label Department Name
          input(type='text', name='depName', id='depName', value=department.depName, required)

        .form-group
          label Description
          input(type='text', name='depDesc', id='depDesc', value=department.depDesc, required)

        .form-actions
          button.btn.btn-gold(type='submit') Save Changes
          a.btn.btn-outline(href='/departments') Cancel
