extends layout
block pageTitle
  | Edit Session – SLU EMS Admin
block content
  a.back-link(href=`/updateEvent/${event.eventID}`) ← Back to Event

  .page-header
    h1 Edit Session

  - const toDateVal = (d) => d ? new Date(d).toISOString().split('T')[0] : ''
  - const toTimeVal = (t) => t ? String(t).substring(0, 5) : ''

  .card
    .card-header
      h2 Session Details
    .card-body
      form.form-wrap(action=`/updateSession/${event.eventID}/${session.sessionID}`, method='POST')
        .form-group
          label Session Description
          input(type='text', name='sessionDesc', id='sessionDesc', value=session.sessionDesc, required)

        .form-grid
          .form-group
            label First Day
            input(type='date', name='firstDay', id='firstDay', value=toDateVal(session.firstDay), required)

          .form-group
            label Last Day
            input(type='date', name='lastDay', id='lastDay', value=toDateVal(session.lastDay), required)

          .form-group
            label Start Time
            input(type='time', name='startTime', id='startTime', value=toTimeVal(session.startTime), required)

          .form-group
            label End Time
            input(type='time', name='endTime', id='endTime', value=toTimeVal(session.endTime), required)

        .form-actions
          button.btn.btn-gold(type='submit') Save Changes
          a.btn.btn-outline(href=`/updateEvent/${event.eventID}`) Cancel
