extends layout
block pageTitle
  | Create Event – SLU EMS Admin
block content
  a.back-link(href='/events') ← Back to Events

  .page-header
    h1 Create New Event

  .card
    .card-header
      h2 Event Details
    .card-body
      form.form-wrap(action='/createEvent', method='POST', enctype='multipart/form-data')
        .form-grid
          .form-group.span-2
            label Event Name
            input(type='text', name='eventName', id='eventName', required, placeholder='Enter event name')

          .form-group.span-2
            label Description
            textarea(name='description', id='description', rows='4', required, placeholder='Describe the event…')

          .form-group
            label Event Category
            select(name='eventCategory', id='eventCategory', required)
              option(value='open') Open
              option(value='university') University
              option(value='departmental') Departmental
              option(value='organizational') Organizational

          .form-group
            label Status
            select(name='eventStatus', id='eventStatus', required)
              option(value='upcoming') Upcoming
              option(value='ongoing') Ongoing
              option(value='done') Done

          .form-group
            label Department
            select(name='depID', id='depID')
              option(value='') None
              each department in departments
                option(value=department.depID)= department.depName

          .form-group
            label Organization
            select(name='orgID', id='orgID')
              option(value='') None
              each org in organizations
                option(value=org.orgID)= org.orgName

          .form-group
            label Start Date
            input(type='date', name='startDate', required)

          .form-group
            label End Date
            input(type='date', name='endDate', required)

          .form-group
            label
              | Venue &nbsp;
              a.btn.btn-sm.btn-outline(href='/createVenue', target='_blank') + New
            select(name='venueID', id='venueID')
              option(value='') None
              each venue in venues
                option(value=venue.venueID) #{venue.venueName} — #{venue.venueAddress}

          .form-group.span-2
            label Event Image
            input(type='file', name='event_img', id='event_img', required)

        .form-actions
          button.btn.btn-gold(type='submit') Create Event
          a.btn.btn-outline(href='/events') Cancel
