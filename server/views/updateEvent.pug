extends layout
block pageTitle
  | Edit Event – SLU EMS Admin
block head
  script(src='/scripts/readEvent.js')
block content
  a.back-link(href=`/readEvent/${event.eventID}`) ← Back to Event

  .page-header
    h1 Edit: #{event.eventName}

  .card
    .card-header
      h2 Event Details
    .card-body
      form.form-wrap(action=`/updateEvent/${event.eventID}`, method='POST', enctype='multipart/form-data')
        .form-grid
          .form-group.span-2
            label Event Name
            input(type='text', name='eventName', value=event.eventName, required)

          .form-group.span-2
            label Description
            textarea(name='description', rows='4', required)= event.description

          .form-group
            label Category
            select(name='eventCategory', required)
              option(value='open', selected=event.eventCategory === 'open') Open
              option(value='university', selected=event.eventCategory === 'university') University
              option(value='departmental', selected=event.eventCategory === 'departmental') Departmental
              option(value='organizational', selected=event.eventCategory === 'organizational') Organizational

          .form-group
            label Status
            select(name='eventStatus', required)
              option(value='upcoming', selected=event.eventStatus === 'upcoming') Upcoming
              option(value='ongoing', selected=event.eventStatus === 'ongoing') Ongoing
              option(value='done', selected=event.eventStatus === 'done') Done

          .form-group
            label Department
            select(name='depID')
              option(value='') None
              each dept in departments
                option(value=dept.depID, selected=event.depID === dept.depID)= dept.depName

          .form-group
            label Organization
            select(name='orgID')
              option(value='') None
              each org in organizations
                option(value=org.orgID, selected=event.orgID === org.orgID)= org.orgName

          - const startVal = event.startDate ? new Date(event.startDate).toISOString().split('T')[0] : ''
          - const endVal   = event.endDate   ? new Date(event.endDate).toISOString().split('T')[0]   : ''
          input(type='hidden', name='scheduleID', value=event.scheduleID || '')

          .form-group
            label Start Date
            input(type='date', name='startDate', value=startVal, required)

          .form-group
            label End Date
            input(type='date', name='endDate', value=endVal, required)

          .form-group
            label Venue
            select(name='venueID')
              option(value='') None
              each venue in venues
                option(value=venue.venueID, selected=event.venueID === venue.venueID) #{venue.venueName} — #{venue.venueAddress}

          .form-group.span-2
            label Replace Image (leave blank to keep current)
            if event.event_img
              img.img-preview(src='data:image/jpeg;base64,' + event.event_img, alt='Current image')
            input(type='file', name='event_img')

        .form-actions
          button.btn.btn-gold(type='submit') Save Changes
          a.btn.btn-outline(href=`/readEvent/${event.eventID}`) Cancel

  if event.sessionIDs.length > 0
    .section-title
      span Sessions
      a.btn.btn-outline.btn-sm(href=`/createSession/${event.eventID}`) + Add Session
    .table-wrap
      table
        thead
          tr
            th Description
            th Days
            th Time
            th Actions
        tbody
          each sessionId, index in event.sessionIDs
            tr
              td= event.sessionDescs[index]
              td #{event.firstDays[index]} – #{event.lastDays[index]}
              td #{event.startTimes[index]} – #{event.endTimes[index]}
              td
                .td-actions
                  a.btn.btn-primary.btn-sm(href=`/updateSession/${event.eventID}/${sessionId}`) Edit
                  a.btn.btn-danger.btn-sm(href=`/deleteSession/${event.eventID}/${sessionId}`, onclick='return confirm("Delete this session?")') Delete
  else
    p.back-link No sessions yet. #[a(href=`/createSession/${event.eventID}`) Add one.]
