head
    link(rel='stylesheet', type='text/css', href='/styles/styles.css')
include menu

title Create Schedule

- function formatDate(date) {
  - const year = date.getFullYear();
  - const month = String(date.getMonth() + 1).padStart(2, '0');
  - const day = String(date.getDate()).padStart(2, '0');
  - return `${year}-${month}-${day}`;
- }

form(action='/createSchedule/', method='POST', class='form')
    label(for='duration') Schedule Duration:
    input(type='text', name='duration', id='duration', required)

    label(for='startDate') First Day:
    - const defaultStartDate = formatDate(new Date()); 
    input(type='date', name='startDate', id='startDate', value=defaultStartDate)

    label(for='endDate') Last Day:
    - const defaultEndDate = formatDate(new Date()); 
    input(type='date', name='endDate', id='endDate', value=defaultEndDate)

    button(type='submit') Add
include footer