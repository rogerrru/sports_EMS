extends layout
block pageTitle
  | Edit Organization – SLU EMS Admin
block content
  a.back-link(href='/organizations') ← Back to Organizations

  .page-header
    h1 Edit: #{organization.orgName}

  .card
    .card-header
      h2 Organization Details
    .card-body
      form.form-wrap(action=`/updateOrganization/${organization.orgID}`, method='POST')
        .form-group
          label Organization Name
          input(type='text', name='orgName', id='orgName', value=organization.orgName, required)

        .form-group
          label Is this an SLU organization?
          select(name='SLUorg', id='SLUorg', required)
            option(value='1', selected=organization.SLUorg == 1) Yes
            option(value='0', selected=organization.SLUorg == 0) No

        .form-actions
          button.btn.btn-gold(type='submit') Save Changes
          a.btn.btn-outline(href='/organizations') Cancel
