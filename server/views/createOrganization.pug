extends layout
block pageTitle
  | Create Organization – SLU EMS Admin
block content
  a.back-link(href='/organizations') ← Back to Organizations

  .page-header
    h1 Create Organization

  .card
    .card-header
      h2 Organization Details
    .card-body
      form.form-wrap(action='/createOrganization', method='POST')
        .form-group
          label Organization Name
          input(type='text', name='orgName', id='orgName', required, placeholder='e.g. Computer Society')

        .form-group
          label Is this an SLU organization?
          select(name='SLUorg', id='SLUorg', required)
            option(value='1') Yes
            option(value='0') No

        .form-actions
          button.btn.btn-gold(type='submit') Create Organization
          a.btn.btn-outline(href='/organizations') Cancel
