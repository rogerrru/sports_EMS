extends layout
block pageTitle
  | Departments – SLU EMS Admin
block content
  .page-header
    h1 Departments
    .page-actions
      a.btn.btn-gold(href='/createDepartment') + New Department

  .toolbar
    form.search-form(action='/searchDepartment', method='GET')
      input(type='text', name='search', placeholder='Search departments…')
      button.btn.btn-primary(type='submit') Search

  if departments.length
    .table-wrap
      table
        thead
          tr
            th Name
            th Description
            th Actions
        tbody
          each dept in departments
            tr
              td= dept.depName
              td= dept.depDesc
              td
                .td-actions
                  a.btn.btn-primary.btn-sm(href=`/updateDepartment/${dept.depID}`) Edit
                  a.btn.btn-danger.btn-sm(href=`/deleteDepartment/${dept.depID}`, onclick='return confirm("Delete this department?")') Delete
  else
    .empty
      p No departments found. #[a(href='/createDepartment') Create the first one.]
