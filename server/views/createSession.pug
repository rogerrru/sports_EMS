extends layout
block pageTitle
  | Create Session – SLU EMS Admin
block content
  a.back-link(href=`/readEvent/${event.eventID}`) ← Back to Event

  .page-header
    h1 Create Session

  - const toDateVal = (d) => d ? new Date(d).toISOString().split('T')[0] : ''
  - const toTimeVal = (t) => t ? String(t).substring(0, 5) : ''
  - const autoFirstDay  = lastSession ? toDateVal(lastSession.lastDay)  : ''
  - const autoStartTime = lastSession ? toTimeVal(lastSession.endTime)  : ''

  if lastSession
    .alert.alert-info(style='margin-bottom:1.6rem')
      | Auto-filled from previous session — starts where
      strong  #{lastSession.sessionDesc}
      |  left off (#{autoFirstDay} at #{autoStartTime})

  .card
    .card-header
      h2 Session Details
    .card-body
      form.form-wrap(action=`/createSession/${event.eventID}`, method='POST')
        .form-group
          label Session Description
          input(type='text', name='sessionDesc', id='sessionDesc', required, placeholder='e.g. Day 1 – Morning Session')

        .form-grid
          .form-group
            label First Day
            input(type='date', name='firstDay', id='firstDay', value=autoFirstDay, required)

          .form-group
            label Last Day
            input(type='date', name='lastDay', id='lastDay', required)

          .form-group
            label Start Time
            input(type='time', name='startTime', id='startTime', value=autoStartTime, required)

          .form-group
            label End Time
            input(type='time', name='endTime', id='endTime', required)

        .form-actions
          button.btn.btn-gold(type='submit') Create Session
          a.btn.btn-outline(href=`/readEvent/${event.eventID}`) Cancel
