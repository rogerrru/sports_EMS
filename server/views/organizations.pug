extends layout
block pageTitle
  | Organizations – SLU EMS Admin
block content
  .page-header
    h1 Organizations
    .page-actions
      a.btn.btn-gold(href='/createOrganization') + New Organization

  .toolbar
    form.search-form(action='/searchOrganization', method='GET')
      input(type='text', name='search', placeholder='Search organizations…')
      button.btn.btn-primary(type='submit') Search

  if organizations.length
    .table-wrap
      table
        thead
          tr
            th Name
            th SLU Org
            th Actions
        tbody
          each org in organizations
            tr
              td= org.orgName
              td= org.SLUorg ? 'Yes' : 'No'
              td
                .td-actions
                  a.btn.btn-primary.btn-sm(href=`/updateOrganization/${org.orgID}`) Edit
                  a.btn.btn-danger.btn-sm(href=`/deleteOrganization/${org.orgID}`, onclick='return confirm("Delete this organization?")') Delete
  else
    .empty
      p No organizations found. #[a(href='/createOrganization') Create the first one.]
