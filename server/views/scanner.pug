extends layout
block pageTitle
  | Scanner – #{session.eventName} – SLU EMS Admin
block head
  script(src='https://unpkg.com/html5-qrcode')
block content
  a.back-link(href=`/readEvent/${session.eventID}`) ← Back to Event

  .page-header
    h1 QR Scanner
    .page-actions
      span(style='font-size:13px;color:#64748b') #{session.eventName} — #{session.sessionDesc}

  if error
    .alert.alert-error
      strong ⚠ Scan failed: &nbsp;
      | #{error}
  if success
    .alert.alert-success
      strong ✓ &nbsp;
      | #{success}

  .scanner-layout
    .card
      .card-header
        h2 Scan QR Code
      .card-body
        div#reader
        form#qrCodeForm(method='post', action=`/processQRCode/${session.eventID}/${session.sessionID}`)
          input(type='hidden', name='sessionId', value=session.sessionID)
          input(type='hidden', id='qrCodeInput', name='qrCodeData')

    .card
      .card-header
        h2 Session Info
      .card-body
        .info-grid
          .info-item
            .info-label Event
            .info-value= session.eventName
          .info-item
            .info-label Session
            .info-value= session.sessionDesc
          .info-item
            .info-label Schedule
            .info-value #{session.firstDay} – #{session.lastDay}
          .info-item
            .info-label Time
            .info-value #{session.startTime} – #{session.endTime}
          if session.departmentName
            .info-item
              .info-label Department
              .info-value= session.departmentName
          if session.organizationName
            .info-item
              .info-label Organization
              .info-value= session.organizationName

        .section-title(style='margin-top:20px') Attendance (#{eventAttendance.length})
        if eventAttendance.length > 0
          .table-wrap(style='margin-top:12px')
            table
              thead
                tr
                  th Name
                  th Date & Time
              tbody
                each att in eventAttendance
                  tr
                    td #{att.lastName}, #{att.firstName}
                    td= att.attendanceDateTime
        else
          p(style='color:#94a3b8;font-size:13.5px;margin-top:12px') No attendance records yet.

  script.
    const scanner = new Html5QrcodeScanner('reader', { qrbox: { width: 250, height: 250 }, fps: 20 });
    scanner.render(function(result) {
      document.getElementById('qrCodeInput').value = result;
      document.getElementById('qrCodeForm').submit();
      scanner.clear();
    }, function(err) { console.error(err); });
