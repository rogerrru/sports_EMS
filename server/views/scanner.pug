head
    link(rel='stylesheet', type='text/css', href='/styles/styles.css')
    title #{session.eventName} Session
include menu
script(src='https:unpkg.com/html5-qrcode')

style
    | .result {
    |   background-color: green;
    |   color: #fff;
    |   padding: 20px;
    | }
    | .row {
    |   display: flex;
    | }

div.row
    div.col
        div(style='width:500px;', id='reader')
    div.col(style='padding:30px;')
        h4 SCAN RESULT
        div#result Result Here

form(id='qrCodeForm', method='post', action=`/processQRCode/${session.eventID}/${session.sessionID}`)
    input(type='hidden', name='sessionId', value=session.sessionID)
    input(type='hidden', id='qrCodeInput', name='qrCodeData')

script.
    const scanner = new Html5QrcodeScanner('reader', {
        // Scanner will be initialized in DOM inside element with id of 'reader'
        qrbox: {
            width: 250,
            height: 250,
        },  // Sets dimensions of scanning box (set relative to reader element width)
        fps: 20, // Frames per second to attempt a scan
    });


    scanner.render(success, error);
    // Starts scanner

    function success(result) {

        document.getElementById('result').innerHTML = `
            <h2>Success!</h2>
            <p><a href="${result}">${result}</a></p>
            `;
        document.getElementById('qrCodeInput').value = result;
        document.getElementById('qrCodeForm').submit();

        scanner.clear();
        // Clears scanning instance

    }

    function error(err) {
        console.error(err);
        // Prints any errors to the console
    }

div.row
    div.col
        div(style='width:500px;', id='reader2')
    div.col(style='padding:30px;')
        h1 #{session.eventName} - #{session.sessionDesc} Session Details
        p Event Description: #{session.eventDescription}
        p Event Status: #{session.eventStatus}
        p Event Category: #{session.eventCategory}
        - if (session.departmentName)
            p Department: #{session.departmentName}
        - else 
            p
        - if (session.organizationName)
            p Organization: #{session.organizationName}
        - else 
            p

        h2 Session Details
        p Schedule: #{session.firstDay} - #{session.lastDay}
        p Time: #{session.startTime} - #{session.endTime}

        h2 Event Attendance
        if eventAttendance.length > 0
            table
                thead
                    tr
                        th Attendance ID
                        th User Name
                        th Attendance Date Time
                tbody
                    each attendance in eventAttendance
                        tr
                            td #{attendance.attendanceID}
                            td #{attendance.lastName}, #{attendance.firstName}
                            td #{attendance.attendanceDateTime}
        else
            p No attendance records for this session
        include footer
