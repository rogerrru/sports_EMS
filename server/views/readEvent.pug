extends layout
block pageTitle
  | #{event.eventName} – SLU EMS Admin
block head
  script(src='/scripts/readEvent.js')
block content
  a.back-link(href='/events') ← Back to Events

  .page-header
    h1= event.eventName
    .page-actions
      a.btn.btn-outline(href=`/updateEvent/${event.eventID}`) Edit Event
      a.btn.btn-danger(href=`/deleteEvent/${event.eventID}`, onclick='return confirm("Delete this event?")') Delete

  .info-grid
    .info-item
      .info-label Status
      .info-value
        span(class='badge badge-' + event.eventStatus)= event.eventStatus
    .info-item
      .info-label Category
      .info-value= event.eventCategory
    if event.departmentName
      .info-item
        .info-label Department
        .info-value= event.departmentName
    if event.organizationName
      .info-item
        .info-label Organization
        .info-value= event.organizationName
    if event.startDate
      .info-item
        - const sd = `${event.startDate.getFullYear()}-${String(event.startDate.getMonth()+1).padStart(2,'0')}-${String(event.startDate.getDate()).padStart(2,'0')}`;
        - const ed = `${event.endDate.getFullYear()}-${String(event.endDate.getMonth()+1).padStart(2,'0')}-${String(event.endDate.getDate()).padStart(2,'0')}`;
        .info-label Schedule
        .info-value #{sd} – #{ed}
    if event.venueName
      .info-item
        .info-label Venue
        .info-value #{event.venueName} — #{event.venueAddress}

  if event.description
    .card
      .card-header
        h2 Description
      .card-body
        p= event.description

  if event.event_img
    .card
      .card-header
        h2 Event Image
      .card-body
        img.img-preview(src='data:image/jpeg;base64,' + event.event_img, alt=event.eventName, style='max-width:400px;height:auto;')

  .section-title
    span Sessions
    a.btn.btn-gold.btn-sm(href=`/createSession/${event.eventID}`) + Add Session

  if event.sessionIDs.length > 0
    .table-wrap
      table
        thead
          tr
            th Description
            th Days
            th Time
            th Actions
        tbody
          each sessionId, index in event.sessionIDs
            tr
              td= event.sessionDescs[index]
              td #{event.firstDays[index]} – #{event.lastDays[index]}
              td #{event.startTimes[index]} – #{event.endTimes[index]}
              td
                .td-actions
                  a.btn.btn-outline.btn-sm(href='javascript:void(0)', onclick=`openParticipantsPopup(${event.eventID}, ${sessionId})`) Participants
                  a.btn.btn-primary.btn-sm(href=`/scanner/${event.eventID}/${sessionId}`) Scanner
                  a.btn.btn-danger.btn-sm(href=`/deleteSession/${event.eventID}/${sessionId}`, onclick='return confirm("Delete session?")') Delete
  else
    p(style='color:#94a3b8;font-size:13.5px') No sessions yet.
