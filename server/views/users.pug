extends layout
block pageTitle
  | Users – SLU EMS Admin
block content
  .page-header
    h1 Users
    .page-actions
      a.btn.btn-gold(href='/createUser') + New User

  .toolbar
    form.search-form(action='/searchUser', method='GET')
      input(type='text', name='search', placeholder='Search users…')
      button.btn.btn-primary(type='submit') Search

  if users.length
    .table-wrap
      table
        thead
          tr
            th ID
            th Name
            th Email
            th Type
            th Actions
        tbody
          each user in users
            tr
              td= user.userID
              td #{user.firstName} #{user.lastName}
              td= user.email
              td
                span(class='badge ' + (user.userType === 'admin' ? 'badge-upcoming' : 'badge-done'))= user.userType
              td
                .td-actions
                  a.btn.btn-outline.btn-sm(href=`/readUser/${user.userID}`) View
                  a.btn.btn-primary.btn-sm(href=`/updateUser/${user.userID}`) Edit
                  a.btn.btn-danger.btn-sm(href=`/deleteUser/${user.userID}`, onclick='return confirm("Delete this user?")') Delete
  else
    .empty
      p No users found. #[a(href='/createUser') Create the first one.]
