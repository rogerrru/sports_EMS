extends layout
block pageTitle
  | Create Venue – SLU EMS Admin
block content
  a.back-link(href='/events') ← Back to Events

  .page-header
    h1 Create Venue

  .card
    .card-header
      h2 Venue Details
    .card-body
      form.form-wrap(action='/createVenue/', method='POST')
        .form-group
          label Venue Name
          input(type='text', name='venueName', id='venueName', required, placeholder='e.g. SLU Gym')

        .form-group
          label Address
          input(type='text', name='venueAddress', id='venueAddress', required, placeholder='Full address')

        .form-actions
          button.btn.btn-gold(type='submit') Create Venue
          a.btn.btn-outline(href='/events') Cancel
