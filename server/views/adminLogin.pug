doctype html
html(lang='en')
  head
    meta(charset='UTF-8')
    meta(name='viewport', content='width=device-width, initial-scale=1.0')
    title Admin Login – SLU EMS
    style.
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        font-family: 'Segoe UI', system-ui, sans-serif;
        background: linear-gradient(135deg, #001e36 0%, #003B5C 100%);
        display: flex; align-items: center; justify-content: center;
        min-height: 100vh; padding: 20px;
      }
      .card {
        background: #fff; border-radius: 12px;
        box-shadow: 0 8px 32px rgba(0,0,0,.25);
        width: 100%; max-width: 400px; overflow: hidden;
      }
      .card-header {
        background: linear-gradient(135deg, #002744, #003B5C);
        border-bottom: 4px solid #C9A84C;
        padding: 28px 28px 22px; text-align: center; color: #fff;
      }
      .brand { font-size: 22px; font-weight: 700; letter-spacing: .04em; }
      .sub { font-size: 12px; color: #C9A84C; text-transform: uppercase; letter-spacing: .12em; margin-top: 4px; }
      .card-body { padding: 28px; }
      label { display: block; font-size: 12px; font-weight: 600; color: #64748b; text-transform: uppercase; letter-spacing: .06em; margin-bottom: 6px; margin-top: 16px; }
      label:first-of-type { margin-top: 0; }
      input { width: 100%; padding: 10px 13px; border: 1.5px solid #e2e8f0; border-radius: 8px; font-size: 14px; color: #1a2a3a; outline: none; transition: border-color .15s; }
      input:focus { border-color: #003B5C; box-shadow: 0 0 0 3px rgba(0,59,92,.08); }
      button { margin-top: 22px; width: 100%; padding: 11px; background: #003B5C; color: #fff; border: none; border-radius: 8px; font-size: 14px; font-weight: 600; cursor: pointer; transition: background .15s; }
      button:hover { background: #1a5c8a; }
      .error { background: #fef2f2; border: 1px solid #fca5a5; color: #b91c1c; border-radius: 8px; padding: 10px 13px; font-size: 13px; margin-bottom: 16px; }
  body
    .card
      .card-header
        .brand SLU EMS
        .sub Admin Panel
      .card-body
        if error
          .error= error
        form(method='POST', action='/admin/login')
          label(for='email') Email Address
          input#email(type='email', name='email', required, autofocus, placeholder='admin@slu.edu.ph')
          label(for='password') Password
          input#password(type='password', name='password', required, placeholder='••••••••')
          button(type='submit') Sign In
