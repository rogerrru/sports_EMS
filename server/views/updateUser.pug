extends layout
block pageTitle
  | Edit User – SLU EMS Admin
block content
  a.back-link(href=`/readUser/${user.userID}`) ← Back to User

  .page-header
    h1 Edit: #{user.firstName} #{user.lastName}

  .card
    .card-header
      h2 User Details
    .card-body
      form.form-wrap(action=`/updateUser/${user.userID}`, method='POST')
        .form-grid
          .form-group
            label First Name
            input(type='text', name='firstName', value=user.firstName, required)

          .form-group
            label Last Name
            input(type='text', name='lastName', value=user.lastName, required)

          .form-group
            label Email
            input(type='email', name='email', value=user.email, required)

          .form-group
            label New Password
            input(type='password', name='password', required, placeholder='Enter new password')

          .form-group
            label User Type
            select(name='userType', required)
              option(value='admin', selected=user.userType === 'admin') Admin
              option(value='user', selected=user.userType === 'user') User

          .form-group
            label Department
            select(name='depID')
              option(value='') None
              each dept in departments
                option(value=dept.depID, selected=user.depID === dept.depID)= dept.depName

          .form-group.span-2
            label Organization
            select(name='orgID')
              option(value='') None
              each org in organizations
                option(value=org.orgID, selected=user.orgID === org.orgID)= org.orgName

        .form-actions
          button.btn.btn-gold(type='submit') Save Changes
          a.btn.btn-outline(href=`/readUser/${user.userID}`) Cancel
