head
  title #{user.firstName} #{user.lastName} - Update
  link(rel='stylesheet', type='text/css', href='/styles/styles.css')

include menu

form(action=`/updateUser/${user.userID}`, method='POST', class='form')
  label(for='firstName') First Name:
  input(type='text', name='firstName', id='firstName', value=user.firstName, required)

  label(for='lastName') Last Name:
  input(type='text', name='lastName', id='lastName' ,value=user.lastName, required)

  label(for='password') Password:
  input(type='password', name='password', id='password', value=user.password, required)

  label(for='email') Email:
  input(type='email', name='email', id='email', value=user.email, required)

  label(for='userType') User Type:
  select(name='userType', id='userType', required)
        option(value='admin', selected=user.userType === 'admin') Admin
        option(value='user', selected=user.userType === 'user') User

  div(id='departmentSection' style='display: block;')
        label(for='depID') Department:
        select(name='depID', id='depID')
            option(value='') None
            each department in departments
                option(value=department.depID, selected=user.depID === department.depID) #{department.depName}

  div(id='organizationSection' style='display: block;')
        label(for='orgID') Organization:
        select(name='orgID', id='orgID')
            option(value='') None
            each org in organizations
                option(value=org.orgID, selected=user.orgID === org.orgID) #{org.orgName}

  button(type='submit') Update User

include footer
