extends layout
block pageTitle
  | Create User – SLU EMS Admin
block content
  a.back-link(href='/users') ← Back to Users

  .page-header
    h1 Create User Account

  .card
    .card-header
      h2 User Details
    .card-body
      form.form-wrap(action='/createUser', method='POST')
        .form-grid
          .form-group
            label First Name
            input(type='text', name='firstName', id='firstName', required, placeholder='First name')

          .form-group
            label Last Name
            input(type='text', name='lastName', id='lastName', required, placeholder='Last name')

          .form-group
            label Email Address
            input(type='email', name='email', id='email', required, placeholder='user@slu.edu.ph')

          .form-group
            label Password
            input(type='password', name='password', id='password', required, placeholder='••••••••')

        .form-actions
          button.btn.btn-gold(type='submit') Create User
          a.btn.btn-outline(href='/users') Cancel
