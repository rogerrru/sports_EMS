# Copy this file to .env and fill in the values

# Node environment (development | production)
NODE_ENV=development

# Server port (Render sets this automatically; leave blank for local)
PORT=3000

# PostgreSQL connection string
# Local: postgresql://postgres:password@localhost:5432/sports_ems
# Render: copy the "External Database URL" from your database's dashboard
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Session secret – use a long random string in production
SESSION_SECRET=change-me-to-a-long-random-secret

# Comma-separated list of allowed frontend origins
# Example: https://your-org.github.io,http://localhost:5500
CLIENT_ORIGIN=http://localhost:5500
